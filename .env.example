# Local OpenAI-compatible chat endpoint exposed by llama-server or another local gateway.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=gemma-4-e4b
LOCAL_LLM_API_KEY=

# Required when LOCAL_LLM_BASE_URL points to the Cloudflare Tunnel hostname.
# Keep this in .env.tunnel or Cloudflare Workers Secret, never in Git.
LOCAL_LLM_TUNNEL_TOKEN=

# Optional defense-in-depth when the Tunnel hostname is protected by Cloudflare Access.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional OpenAI-compatible embedding endpoint. Keep generation and embeddings separate.
EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
EMBEDDING_MODEL=embedding-model

# Set to 1 only when the Cloudflare Vectorize index has been provisioned.
VECTOR_SEARCH_ENABLED=0
